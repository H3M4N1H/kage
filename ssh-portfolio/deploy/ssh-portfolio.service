[Unit]
Description=Hemanth read-only SSH portfolio
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ssh-portfolio
Group=ssh-portfolio
WorkingDirectory=/var/lib/ssh-portfolio
StateDirectory=ssh-portfolio
StateDirectoryMode=0700
Environment=PORTFOLIO_ADDR=127.0.0.1:2222
Environment=PORTFOLIO_HOST_KEY=/var/lib/ssh-portfolio/host_ed25519
EnvironmentFile=-/etc/ssh-portfolio.env
ExecStart=/opt/ssh-portfolio/ssh-portfolio
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/ssh-portfolio
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=true
SystemCallArchitectures=native
MemoryMax=256M
CPUQuota=100%
TasksMax=128
LimitNOFILE=256
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
